# Copy to .env.local and fill in. For the Day-1 UI demo, no values are required:
# the app runs with seeded DEMO data when DEMO_LOCAL=1.

DEMO_LOCAL=1

# Supabase free tier — required only to switch off demo mode
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
DATABASE_URL=
DIRECT_URL=

# Gemini free API — required only for live counselling generation
GOOGLE_GENERATIVE_AI_API_KEY=
# Optional: defaults to gemini-2.5-flash
GEMINI_MODEL=

# Free external cron
CRON_SECRET=change-me-to-a-long-random-string
NEXT_PUBLIC_APP_URL=http://localhost:3000
